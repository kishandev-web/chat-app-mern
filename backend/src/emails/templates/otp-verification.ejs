<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>OTP Verification</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f5f5f5;
    font-family: Arial, Helvetica, sans-serif;
  ">
  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f5f5f5; padding: 20px 0">
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table width="600" cellpadding="0" cellspacing="0" border="0" style="
            background-color: #ffffff;
            border-radius: 8px;
            overflow: hidden;
          ">

          <!-- Header -->
          <tr>
            <td style="padding: 20px; border-bottom: 2px solid #2563eb;">

              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>

                  <!-- Title -->
                  <td align="left" valign="middle">
                    <h1 style="
                        margin: 0;
                        font-size: 24px;
                        color: #2563eb;
                        font-weight: bold;
                      ">
                      OTP Verification
                    </h1>
                  </td>

                  <!-- Logo -->
                  <td align="right" valign="middle">
                    <img src="<%= logoUrl %>" alt="Company Logo" width="100"
                      style="display: block; border: 0; padding-top: 10px" />
                  </td>

                </tr>
              </table>

            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding: 40px 30px; text-align: center">

              <!-- Greeting -->
              <h2 style="
                  margin-top: 0;
                  color: #333333;
                  font-size: 24px;
                ">
                Hello <%= userName %>,
              </h2>

              <!-- Message -->
              <p style="
                  font-size: 16px;
                  line-height: 1.6;
                  color: #555555;
                  margin: 20px 0;
                ">
                Use the following One-Time Password (OTP) to verify your account.
              </p>

              <!-- OTP Box -->
              <table cellpadding="0" cellspacing="0" border="0" align="center" style="
                  margin-top: 30px;
                  margin-bottom: 30px;
                ">
                <tr>
                  <td align="center" bgcolor="#2563eb" style="
                      border-radius: 8px;
                      padding: 18px 40px;
                    ">
                    <span style="
                        font-size: 32px;
                        font-weight: bold;
                        letter-spacing: 8px;
                        color: #ffffff;
                      ">
                      <%= otp %>
                    </span>
                  </td>
                </tr>
              </table>

              <!-- Expiry Message -->
              <p style="
                  font-size: 15px;
                  color: #666666;
                  line-height: 1.6;
                  margin-top: 10px;
                ">
                This OTP is valid for
                <strong style="color: #2563eb;">15 minutes</strong>.
              </p>

              <!-- Security Info -->
              <p style="
                  font-size: 14px;
                  color: #999999;
                  margin-top: 35px;
                  line-height: 1.5;
                ">
                If you did not request this OTP, please ignore this email
                or contact support immediately.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>
</body>

</html>